{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["*"],
      "@test-utils/*": ["test-utils/*"],
      "@components/*": ["components/*"],
      "@patterns/*": ["patterns/*"],
      "@primitives/*": ["primitives/*"],
      "@styles/*": ["styles/*"],
      "@utils/*": ["utils/*"],
      "@assets/*": ["assets/*"]
    }
  },
  "include": ["src/**/*.stories.ts", "src/**/*.stories.tsx"]
}
