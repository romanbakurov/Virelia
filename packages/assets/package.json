{
  "name": "@vellira-ui/assets",
  "version": "2.18.4",
  "description": "Shared static assets for Vellira Design System",
  "author": "Roman Bakurov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vellira-dev/vellira",
    "directory": "packages/assets"
  },
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    "./styles": "./styles/fonts.css",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*",
    "./sync-brand": "./scripts/sync-brand.mjs"
  },
  "files": [
    "brand",
    "fonts",
    "scripts",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vellira-sync-brand": "./scripts/sync-brand.mjs"
  },
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
