{
  "expo": {
    "name": "native-storybook",
    "slug": "native-storybook",
    "version": "1.0.0",
    "scheme": "vellira-native-storybook",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.romanbakurov.vellira.storybook"
    },
    "android": {
      "package": "com.romanbakurov.vellira.storybook",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
