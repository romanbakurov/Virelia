{
  "name": "@vellira-ui/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:brand": "pnpm --filter @vellira-ui/assets sync-brand apps/website/public/brand",
    "sync:tokens": "pnpm --filter @vellira-ui/tokens build:tokens",
    "sync:components": "pnpm --filter @vellira-ui/react build && pnpm --filter @vellira-ui/react-native build",
    "predev": "pnpm run sync:brand && pnpm run sync:tokens && pnpm run sync:components",
    "dev": "next dev",
    "prebuild": "pnpm run sync:brand && pnpm run sync:tokens && pnpm run sync:components",
    "build": "next build",
    "prestart": "pnpm run sync:brand && pnpm run sync:tokens && pnpm run sync:components",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@vellira-ui/assets": "workspace:*",
    "@vellira-ui/icons": "workspace:*",
    "@vellira-ui/react": "workspace:*",
    "@vellira-ui/react-native": "workspace:*",
    "@vellira-ui/tokens": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "lottie-web": "^5.13.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-web": "^0.21.2",
    "react-server-dom-webpack": "^19.2.8",
    "shiki": "^4.4.2",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@next/mdx": "16.2.11",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5",
    "vite": "^8.2.1",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
